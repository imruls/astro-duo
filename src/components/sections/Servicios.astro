---
import { servicios, auditoriaRedes, getWhatsappLink } from "@data/dataSite";
import Icon from "@ui/Icon.astro";

const MAX_REVEAL_DELAY = 4;
const auditoriaCtaHref = getWhatsappLink(
  "Hola, quiero reservar mi Auditoría de Redes Sociales",
);
---

<!-- SVG symbol reutilizable (se renderiza una sola vez) -->
<svg class="sr-only" aria-hidden="true">
  <symbol
    id="icon-check"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
  >
    <polyline points="20 6 9 17 4 12"></polyline>
  </symbol>
</svg>

<section class="servicios" id="servicios">
  <div class="container">
    <div class="servicios__header reveal">
      <span class="section-label">Nuestros servicios</span>
      <h2 class="section-title">
        Potenciá tu marca con <span>servicios a medida</span>
      </h2>
      <p class="section-subtitle">
        Elegí servicios individuales diseñados para llevar tu presencia digital
        al siguiente nivel.
      </p>
    </div>

    <div class="servicios__grid">
      {
        servicios.map((servicio, i) => {
          const delay = Math.min(i + 1, MAX_REVEAL_DELAY);
          const ctaHref = getWhatsappLink(
            `Hola, me interesa el servicio de ${servicio.title}, quiero más info`,
          );

          return (
            <article
              class:list={["servicio-card", "reveal", `reveal-delay-${delay}`]}
            >
              <div class="servicio-card__info">
                <h3 class="servicio-card__title">{servicio.title}</h3>
                <p class="servicio-card__desc">{servicio.description}</p>
              </div>

              <ul class="servicio-card__list">
                {servicio.items.map((item) => (
                  <li class="servicio-card__item">
                    <svg class="servicio-card__item-icon" aria-hidden="true">
                      <use href="#icon-check" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <a
                href={ctaHref}
                target="_blank"
                rel="noopener noreferrer"
                class="servicio-card__cta"
              >
                Más info
              </a>
            </article>
          );
        })
      }
    </div>

    <div
      class="servicios__dots"
      role="tablist"
      aria-label="Navegar entre servicios"
    >
      {
        servicios.map((servicio, i) => (
          <button
            type="button"
            class="servicios__dot"
            data-dot-index={i}
            aria-label={`Ir al servicio ${i + 1}: ${servicio.title}`}
            aria-current={i === 0 ? "true" : "false"}
          />
        ))
      }
    </div>

    <div class="auditoria reveal">
      <div class="auditoria__header">
        <div class="auditoria__heading">
          <h3 class="auditoria__title">{auditoriaRedes.title}</h3>
          <p class="auditoria__audience">{auditoriaRedes.targetAudience}</p>
        </div>

        <div class="auditoria__price">
          <span class="auditoria__price-value">{auditoriaRedes.price}</span>
          <span class="auditoria__price-note">{auditoriaRedes.priceNote}</span>
        </div>
      </div>

      <div class="auditoria__body">
        <div class="auditoria__col">
          <h4 class="auditoria__col-title">¿Qué incluye?</h4>
          <ul class="auditoria__list">
            {
              auditoriaRedes.includes.map((item) => (
                <li class="auditoria__list-item">
                  <svg class="auditoria__list-icon" aria-hidden="true">
                    <use href="#icon-check" />
                  </svg>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="auditoria__col">
          <h4 class="auditoria__col-title">¿Cómo funciona?</h4>
          <ol class="auditoria__steps">
            {
              auditoriaRedes.steps.map((step, i) => (
                <li class="auditoria__step">
                  <span class="auditoria__step-number">{i + 1}</span>
                  <span>{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <div class="auditoria__meta">
        <Icon name="clock" size={18} />
        <span>
          Tiempo de entrega: <strong>{auditoriaRedes.deliveryTime}</strong>
        </span>
      </div>

      <div class="auditoria__footer">
        <p class="auditoria__final-cta">{auditoriaRedes.finalCta}</p>
        <a
          href={auditoriaCtaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="auditoria__cta btn-primary"
        >
          {auditoriaRedes.ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .servicios {
    padding: var(--space-2xl) 0;
    background: var(--cream);
  }

  .servicios__header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .servicios__header .section-subtitle {
    margin-inline: auto;
  }

  .servicios__header .section-title span {
    font-family: var(--font-display);
    font-weight: 400;
  }

  /* Carrusel (mobile / tablet): grid horizontal con scroll-snap.
     grid-auto-flow: column + grid-template-rows hace que TODAS las cards
     compartan las mismas 2 pistas de fila (info / lista), de modo que los
     listados arrancan siempre en la misma línea del eje X. */
  .servicios__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 85%;
    grid-template-rows: auto auto auto;
    gap: var(--space-md);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-sm);
  }

  .servicios__grid::-webkit-scrollbar {
    display: none;
  }

  /* Dots: solo visibles mientras el layout es carrusel */
  .servicios__dots {
    display: none;
  }

  @media (min-width: 640px) {
    .servicios__grid {
      grid-auto-columns: calc((100% - var(--space-md)) / 2);
    }
  }

  @media (max-width: 1023px) {
    /* Indicadores de posición */
    .servicios__dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.5rem;
      margin-top: var(--space-md);
    }

    .servicios__dot {
      width: 8px;
      height: 8px;
      padding: 0;
      border: none;
      border-radius: 50%;
      background: rgba(123, 139, 62, 0.3);
      cursor: pointer;
      transition:
        width 0.3s ease,
        background 0.3s ease;
    }

    .servicios__dot:hover {
      background: rgba(123, 139, 62, 0.55);
    }

    .servicios__dot[aria-current="true"] {
      width: 24px;
      border-radius: var(--radius-full);
      background: var(--olive);
    }
  }

  /* Desktop: las 4 cards visibles a la vez, sin carrusel */
  @media (min-width: 1024px) {
    .servicios__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      overflow: visible;
      scroll-snap-type: none;
      padding-bottom: 0;
    }
  }

  /* Card */
  .servicio-card {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    gap: var(--space-md);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    background: var(--white);
    border: 1px solid rgba(123, 139, 62, 0.2);
  }

  .servicio-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.08);
  }

  .servicio-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 80% 20%,
      rgba(255, 255, 255, 0.4) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .servicio-card__info {
    position: relative;
  }

  .servicio-card__title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }

  .servicio-card__desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Listado de servicios */
  .servicio-card__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    list-style: none;
  }

  .servicio-card__item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0;
    font-size: 0.9rem;
    color: var(--text-dark);
    border-bottom: 1px solid rgba(123, 139, 62, 0.15);
  }

  .servicio-card__item:last-child {
    border-bottom: none;
  }

  .servicio-card__item-icon {
    width: 18px;
    height: 18px;
    color: var(--olive);
    flex-shrink: 0;
  }

  /* CTA */
  .servicio-card__cta {
    position: relative;
    display: block;
    align-self: end;
    padding: 0.75rem 1.5rem;
    border: 1.5px solid var(--olive);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--olive);
    text-align: center;
    text-decoration: none;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .servicio-card__cta:hover {
    background: var(--olive);
    color: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(123, 139, 62, 0.3);
  }

  /* Auditoría de Redes — subsección destacada */
  .auditoria {
    position: relative;
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--white);
    border: 1px solid rgba(123, 139, 62, 0.2);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.05);
  }

  .auditoria__badge {
    display: inline-block;
    padding: 0.35rem 0.9rem;
    background: var(--olive);
    color: var(--white);
    border-radius: var(--radius-full);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: var(--space-md);
  }

  .auditoria__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .auditoria__title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-dark);
  }

  .auditoria__audience {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    max-width: 480px;
  }

  .auditoria__price {
    display: flex;
    flex-direction: column;
    align-self: flex-start;
    padding: 0.85rem 1.5rem;
    background: var(--white);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .auditoria__price-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--olive);
    white-space: nowrap;
  }

  .auditoria__price-note {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .auditoria__body {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
  }

  .auditoria__col-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-dark);
    margin-bottom: var(--space-sm);
  }

  .auditoria__list {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    list-style: none;
  }

  .auditoria__list-item {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.55rem 0;
    font-size: 0.9rem;
    color: var(--text-dark);
    line-height: 1.5;
    border-bottom: 1px solid rgba(123, 139, 62, 0.15);
  }

  .auditoria__list-item:last-child {
    border-bottom: none;
  }

  .auditoria__list-icon {
    width: 18px;
    height: 18px;
    margin-top: 2px;
    color: var(--olive);
    flex-shrink: 0;
  }

  .auditoria__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    list-style: none;
  }

  .auditoria__step {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.9rem;
    color: var(--text-dark);
    line-height: 1.5;
  }

  .auditoria__step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--olive);
    color: var(--white);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .auditoria__meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1rem;
    margin-bottom: var(--space-lg);
    background: rgba(123, 139, 62, 0.08);
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    color: var(--text-dark);
  }

  .auditoria__meta svg {
    color: var(--olive);
    flex-shrink: 0;
  }

  .auditoria__footer {
    text-align: center;
  }

  .auditoria__final-cta {
    max-width: 620px;
    margin: 0 auto var(--space-md);
    font-size: 1rem;
    color: var(--text-dark);
    line-height: 1.7;
  }

  .auditoria__cta {
    width: 100%;
  }

  /* Breakpoints */
  @media (min-width: 640px) {
    .auditoria__cta {
      width: auto;
    }
  }

  @media (min-width: 1024px) {
    .auditoria {
      padding: var(--space-xl);
    }

    .auditoria__header {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .auditoria__price {
      align-self: auto;
    }

    .auditoria__body {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-xl);
    }
  }
</style>

<script>
  import { initScrollDots } from "@scripts/scrollDots";

  const grid = document.querySelector<HTMLElement>(".servicios__grid");

  if (grid) {
    const cards = Array.from(
      grid.querySelectorAll<HTMLElement>(".servicio-card"),
    );
    const dots = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".servicios__dot"),
    );

    initScrollDots({ container: grid, items: cards, dots });
  }
</script>
