---
import {
  whatsappUrl as defaultWhatsappUrl,
  whatsappIconSvg,
} from "@data/dataSite";

interface Props {
  whatsappUrl?: string;
}

const { whatsappUrl = defaultWhatsappUrl } = Astro.props;
---

<!-- WhatsApp -->
<a
  href={whatsappUrl}
  class="whatsapp-btn"
  aria-label="Contactar por WhatsApp"
  target="_blank"
  rel="noopener noreferrer"
>
  <Fragment set:html={whatsappIconSvg} />
</a>

<style>
  .whatsapp-btn {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #25d366;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.3);
    transition: var(--transition);
    z-index: 90;
  }

  .whatsapp-btn:hover {
    transform: scale(1.1) translateY(-2px);
    box-shadow: 0 8px 30px rgba(37, 211, 102, 0.4);
  }

  .whatsapp-btn svg {
    width: 26px;
    height: 26px;
  }
</style>
