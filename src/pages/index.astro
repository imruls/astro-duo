---
/**
 * index.astro — Home page
 * Composes all section components inside the base layout.
 * Each component is self-contained (markup + scoped styles + script).
 */
import Layout from "@layouts/Layout.astro";
import Navbar from "@sections/Navbar.astro";
import Hero from "@sections/Hero.astro";
import Servicios from "@sections/Servicios.astro";
import Shop from "@sections/Shop.astro";
import About from "@sections/About.astro";
import Resenas from "@sections/Resenas.astro";
import Contacto from "@sections/Contacto.astro";
import Footer from "@sections/Footer.astro";
import BotonFlotante from "@ui/BotonFlotante.astro";
import { whatsappUrl } from "@data/dataSite";
---

<Layout>
  <Navbar />
  <main>
    <Hero />
    <Servicios />
    <Shop />
    <Resenas />
    <About />
    <Contacto />
  </main>
  <Footer />
  <BotonFlotante whatsappUrl={whatsappUrl} />
</Layout>
